{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ATC Fast-Time Simulation Tool",
  "version": "0.4.0",
  "identifier": "th.co.bearcat.atcfts",
  "build": {
    "frontendDist": "../../web/.next-desktop",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "BearCat AEL Co",
    "copyright": "Copyright (c) 2026 BearCat AEL Co. All rights reserved.",
    "shortDescription": "Air-traffic fast-time simulation and trajectory generation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../sidecar/dist/atc-engine/": "engine/",
      "../installer/EULA.txt": "licenses/EULA.txt",
      "../installer/THIRD_PARTY_NOTICES.txt": "licenses/THIRD_PARTY_NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true,
    "licenseFile": "../installer/EULA.txt"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQjUzOUMxMkMwRTYwMDUKUldRRllBNHN3VG0xLzJhNDJqeEZSVjNLR0kydjVnZWtMRWdDMWkvTmxHOGsrdGY4NEhZWFllbDMK",
      "endpoints": [
        "https://github.com/Changplay12345/ATC-Fast-Time-Sim-Performance-Testing-Version/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
