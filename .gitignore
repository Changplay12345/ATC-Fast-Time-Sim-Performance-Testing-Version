.vite/

# Reference documents kept locally (ICAO PANS-ATM is a copyrighted publication)
*.pdf

# Source AIXM exports kept locally: Navigraph/Jeppesen-derived commercial data,
# licensed for internal and demonstration use only, NOT for redistribution. The
# procedure layers built from it (web/public/data/aixm/) are committed so the
# app runs from a clean clone; re-running scripts/ingest_aixm_procedures.py
# needs your own copy of the export.
# (matches both the gzipped export and the plain-XML one.)
aixm_export_*.xml
aixm_export_*.xml.gz

# Report charting (scripts/plot_reports.py): downloaded CSVs in, PNGs out.
# Both hold run output, not source.
/csv/
/graphs/

# Desktop build outputs (PyInstaller, Tauri, static export)
desktop/sidecar/dist/
desktop/sidecar/build/
desktop/src-tauri/target/
web/.next-desktop/
web/out/
desktop/node_modules/
desktop/src-tauri/gen/

# Assembled desktop release (installer + latest.json), uploaded to GitHub Releases
release/

# Generated from EULA.md by scripts/make_installer_license.py
desktop/installer/EULA.txt
desktop/installer/THIRD_PARTY_NOTICES.txt

# Built data packs (zip + data-manifest.json), uploaded to the "data" release
release-data/
